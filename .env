# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database URL
# Replace 'your_postgres_password' with the password you set during installation
DATABASE_URL="postgresql://postgres:1234@localhost:5432/nexusdb?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super_secret_access_token_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="super_secret_refresh_token_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary Setup (Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Nodemailer Setup (Email Sending)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_specific_password"
EMAIL_FROM="KnowledgeHub <noreply@knowledgehub.com>"